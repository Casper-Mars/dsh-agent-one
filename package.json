{
  "name": "dsh-agent-one",
  "version": "0.2.7",
  "type": "module",
  "description": "一体化项目主智能体：一个项目一个会话，内置 pm/cto/dev 角色，自包含部署",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "orchestrator"
  ],
  "author": "Casper <solitaryreach@163.com>",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=11.7.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "main": "dist-server/index.js",
  "exports": {
    ".": {
      "types": "./dist-server/types/index.d.ts",
      "default": "./dist-server/index.js"
    },
    "./assets": {
      "types": "./dist-server/types/assets.d.ts",
      "default": "./dist-server/assets.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./assets/pm": {
      "types": "./dist-server/types/assets-pm.d.ts",
      "default": "./dist-server/assets-pm.js"
    },
    "./assets/cto": {
      "types": "./dist-server/types/assets-cto.d.ts",
      "default": "./dist-server/assets-cto.js"
    },
    "./assets/dev-leader": {
      "types": "./dist-server/types/assets-dev-leader.d.ts",
      "default": "./dist-server/assets-dev-leader.js"
    },
    "./assets/dev-developer": {
      "types": "./dist-server/types/assets-dev-developer.d.ts",
      "default": "./dist-server/assets-dev-developer.js"
    },
    "./assets/dev-tester": {
      "types": "./dist-server/types/assets-dev-tester.d.ts",
      "default": "./dist-server/assets-dev-tester.js"
    },
    "./assets/designer": {
      "types": "./dist-server/types/assets-designer.d.ts",
      "default": "./dist-server/assets-designer.js"
    }
  },
  "files": [
    "dist-server/**/*.js",
    "dist-server/types/**/*.d.ts",
    "dist-server/**/*.md",
    "dist-server/cordis.patch.yml",
    "skills/",
    "cordis.patch.yml",
    "design-kit/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && pnpm typecheck && tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "build:server": "pnpm clean && tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist dist-server",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
